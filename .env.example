# Copy to .env.local for local development. Never commit real values.

# Canonical origin for metadata, Open Graph, sitemap.xml and robots.txt.
# Set it in Vercel > Project > Settings > Environment Variables once the final
# domain is confirmed. When it is unset on Vercel the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which already follows the project's domain.
NEXT_PUBLIC_SITE_URL=https://jayvan.vercel.app

# Contact form (app/actions/contact.ts), sent through Resend's REST API.
# Required. Create it at resend.com > API Keys with "Sending access" only.
# On Vercel, add it as a Sensitive variable for Production.
RESEND_API_KEY=

# Optional. Where messages are delivered. Defaults to the email in data/profile.ts.
# Without a verified domain, Resend only delivers to the address the Resend
# account was created with, so keep that the same as this one.
CONTACT_TO_EMAIL=

# Optional. Sender shown on the email. Defaults to "Portfolio Contact <onboarding@resend.dev>".
# Change only after verifying your own domain in Resend.
CONTACT_FROM_EMAIL=
