# Canonical origin for metadata, Open Graph, sitemap.xml and robots.txt.
# Set it in Vercel > Project > Settings > Environment Variables once the final
# domain is confirmed. When it is unset on Vercel the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which already follows the project's domain.
NEXT_PUBLIC_SITE_URL=https://portfolio-webmaster.vercel.app
